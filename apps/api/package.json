{
  "name": "@security-log-analyzer/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@security-log-analyzer/application": "file:../../packages/application",
    "@security-log-analyzer/contracts": "file:../../packages/contracts",
    "@security-log-analyzer/domain": "file:../../packages/domain",
    "@security-log-analyzer/infrastructure": "file:../../packages/infrastructure",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.6.1",
    "helmet": "^8.3.0",
    "multer": "^2.0.2"
  },
  "devDependencies": {
    "@types/multer": "^2.0.0",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.1.1",
    "vitest": "^3.2.4"
  }
}
